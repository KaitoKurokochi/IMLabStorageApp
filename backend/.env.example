# ==========================================
# IMLab Storage Backend Environment Variables
# ==========================================

# Application Environment (development / production)
APP_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# MongoDB Connection URL
# For local MongoDB: mongodb://localhost:27017
# For Docker: mongodb://mongodb:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017

# Database Name
DATABASE_NAME=imlab_storage

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Directory to store uploaded files
# Relative to backend/ or absolute path
UPLOAD_DIR=static/uploads

# Passphrase Authorization (DB変更操作の合言葉認証)
APP_PASSPHRASE=passphrase
SECRET_KEY=imlab-secret-key-change-in-production
PASSPHRASE_TOKEN_EXPIRE_DAYS=365


