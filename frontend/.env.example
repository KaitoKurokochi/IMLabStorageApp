# ==========================================
# IMLab Storage Frontend Environment Variables
# ==========================================

# Base URL of the backend API
# - For local development with Vite proxy (default): leave empty
# - For production on a separate API host: https://api.imlab.example.com
# - For production behind reverse proxy (same domain /api): leave empty
VITE_API_BASE_URL=

# Vite Dev Server Port
VITE_PORT=5173

# Target backend URL for Vite local dev proxy
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

